{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/stellarcielo/Constella/main/schema/constella.schema.json",
  "title": "Constella トポロジ",
  "description": "Constella(ネットワークトポロジ図エディタ)のトポロジ YAML(*.constella.yaml)。機器(devices)と接続(links)だけを書けば図になる。座標(layout)は省略でき、開くと自動で配置される。仕様: https://github.com/stellarcielo/Constella/blob/main/docs/SPEC.md",
  "type": "object",
  "required": ["constella"],
  "additionalProperties": false,
  "properties": {
    "constella": {
      "description": "形式バージョン。今は 1 だけ。ファイルの先頭に書く",
      "const": 1
    },
    "meta": {
      "description": "図の情報",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "図のタイトル",
          "type": ["string", "number", "boolean"]
        },
        "description": {
          "description": "図の説明",
          "type": ["string", "number", "boolean"]
        }
      }
    },
    "devices": {
      "description": "機器の一覧。キーはデバイスID(英数字で始まり、英数字と . _ - だけ)",
      "type": ["object", "null"],
      "propertyNames": { "$ref": "#/definitions/deviceId" },
      "additionalProperties": { "$ref": "#/definitions/device" }
    },
    "links": {
      "description": "接続の一覧。1 本ごとに両端(a と b)の「デバイスID:IF名」を書く",
      "type": ["array", "null"],
      "items": { "$ref": "#/definitions/link" }
    },
    "layout": {
      "description": "機器の座標(キー = デバイスID。ブリッジと SDN の VNet は「ホストのデバイスID:ブリッジ名」)。GUI で機器を動かすと自動で書き込まれる。座標の無い機器は自動で配置される",
      "type": ["object", "null"],
      "properties": {
        "_viewport": { "$ref": "#/definitions/viewport" },
        "_labels": {
          "description": "手で動かした IF 名ラベルの位置(キー = ラベルの付く端の「デバイスID:IF名」。ブリッジとホストの間の線のホスト側のラベルは「ホスト:ブリッジ名」)。GUI でラベルを動かすと自動で書き込まれる",
          "type": ["object", "null"],
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]*:\\S+$": { "$ref": "#/definitions/labelOffset" }
          },
          "additionalProperties": false
        },
        "_bends": {
          "description": "曲げた線の点(キー = 線の両端のデバイスID。ブリッジなら「ホスト:ブリッジ名」。名前の順に並べて空白でつなぐ)。点は、キーの 1 つ目の機器の側から順に並べる。同じ 2 台の間の線は、まとめて同じ点を通る。GUI で線を曲げると自動で書き込まれる",
          "type": ["object", "null"],
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]*(:\\S+)? [A-Za-z0-9][A-Za-z0-9._-]*(:\\S+)?$": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/point" }
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]*$": { "$ref": "#/definitions/position" },
        "^[A-Za-z0-9][A-Za-z0-9._-]*:\\S+$": { "$ref": "#/definitions/position" }
      },
      "additionalProperties": false
    },
    "groups": {
      "description": "機器のまとまり(拠点・ラック・VLAN など)。図への表示はフェーズ3で対応する",
      "type": ["array", "null"],
      "items": { "$ref": "#/definitions/group" }
    },
    "sdn": {
      "description": "SDN(Proxmox VE の SDN)のゾーンと VNet。VNet は、ゾーンの各ホストの中のブリッジとして扱い、ゲストは「ホストのデバイスID:VNet ID」につなぐ",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "zones": {
          "description": "ゾーン(キー = ゾーンID)",
          "type": ["object", "null"],
          "additionalProperties": { "$ref": "#/definitions/sdnZone" }
        },
        "vnets": {
          "description": "VNet(キー = VNet ID。Proxmox VE では 8 文字まで)",
          "type": ["object", "null"],
          "additionalProperties": { "$ref": "#/definitions/sdnVnet" }
        }
      }
    }
  },
  "definitions": {
    "deviceId": {
      "description": "デバイスID。英数字で始まり、英数字と . _ - だけを使える(: は使えない)",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "examples": ["rt1", "core-sw1", "srv.web01"]
    },
    "device": {
      "description": "機器。何も書かなければ、どんな IF 名も使える汎用の機器になる",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "description": "モデル(機種)の ID。省略するとフレキシブル(どんな IF 名も使える)。組み込み: generic-router-4 / generic-l2switch-24 / generic-l3switch-48 / generic-firewall-8 / generic-server-2 / generic-pc / generic-ap / generic-cloud / generic-hypervisor-4 / generic-vm / generic-container / cisco-c2960-24tt-l",
          "type": "string",
          "minLength": 1,
          "examples": ["generic-router-4", "generic-l2switch-24", "cisco-c2960-24tt-l"]
        },
        "role": { "$ref": "#/definitions/role" },
        "label": {
          "description": "図に表示する名前。省略するとデバイスID",
          "type": ["string", "number", "boolean"]
        },
        "host": {
          "description": "ゲスト(VM・コンテナ)のとき、動いているホスト(ハイパーバイザなど)のデバイスID",
          "allOf": [{ "$ref": "#/definitions/deviceId" }]
        },
        "guest": {
          "description": "ゲストの種類: vm(仮想マシン)/ container(コンテナ。Proxmox VE の LXC)。省略するとモデルの種類、どちらも無く host があれば vm",
          "type": "string",
          "enum": ["vm", "container"]
        },
        "vmid": {
          "description": "Proxmox VE の VMID(VM・コンテナの番号)",
          "type": "integer",
          "minimum": 100,
          "maximum": 999999999
        },
        "interfaces": {
          "description": "IF ごとの追加情報(キー = IF 名。GigabitEthernet0/1 と Gi0/1 のように長い名前・短い名前のどちらでも書ける)",
          "type": ["object", "null"],
          "additionalProperties": { "$ref": "#/definitions/interface" }
        }
      }
    },
    "role": {
      "description": "機器の役割。図のアイコンと、自動配置の段(上から cloud → router・firewall → l3switch → l2switch・generic → server・hypervisor・pc・ap)を決める。省略するとモデルの役割、モデルも無ければ generic",
      "type": "string",
      "enum": [
        "router",
        "l2switch",
        "l3switch",
        "firewall",
        "server",
        "hypervisor",
        "pc",
        "ap",
        "cloud",
        "generic"
      ]
    },
    "interface": {
      "description": "IF の追加情報",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "IF の説明",
          "type": ["string", "number", "boolean"]
        },
        "ip": {
          "description": "IP アドレス(プレフィックス長付き)の配列",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "examples": [["192.0.2.1/30", "2001:db8::1/64"]]
        },
        "mode": { "$ref": "#/definitions/interfaceMode" },
        "vlan": {
          "description": "access のときの VLAN ID(1〜4094)。ゲストの IF では VLAN タグ(Proxmox VE の tag)、VLAN インターフェースではその VLAN ID",
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "vlans": {
          "description": "trunk のときに通す VLAN(カンマ区切り・範囲指定)。ゲストの IF では Proxmox VE の trunks、VLAN aware なブリッジでは通す VLAN(bridge-vids。省略すると 2-4094)",
          "type": ["string", "number", "boolean"],
          "examples": ["10,20,100-110"]
        },
        "transceiver": {
          "description": "挿しているトランシーバ(光モジュール)。一覧の名前(大文字小文字は区別しない)なら、ポートに合うかと、リンクの両端が合うかを確かめる。一覧に無い名前(製品の型番など)も書けるが、確かめない",
          "anyOf": [
            {
              "enum": [
                "1000BASE-SX",
                "1000BASE-LX",
                "1000BASE-EX",
                "1000BASE-ZX",
                "1000BASE-BX-U",
                "1000BASE-BX-D",
                "1000BASE-T",
                "10GBASE-SR",
                "10GBASE-LRM",
                "10GBASE-LR",
                "10GBASE-ER",
                "10GBASE-ZR",
                "10GBASE-BX-U",
                "10GBASE-BX-D",
                "10GBASE-T",
                "10G-DAC",
                "10G-AOC",
                "25GBASE-SR",
                "25GBASE-LR",
                "25G-DAC",
                "25G-AOC",
                "40GBASE-SR4",
                "40GBASE-LR4",
                "40G-DAC",
                "40G-AOC",
                "100GBASE-SR4",
                "100GBASE-LR4",
                "100GBASE-CWDM4",
                "100GBASE-DR",
                "100G-DAC",
                "100G-AOC"
              ]
            },
            { "type": "string", "minLength": 1 }
          ]
        },
        "type": {
          "description": "論理的な IF の種類: bond / bridge(ブリッジ。ホストの中の仮想スイッチ)/ vlan(VLAN インターフェース)。省略すると物理的な IF。type を書いた IF は、モデルに無い名前でも使える",
          "type": "string",
          "enum": ["bond", "bridge", "vlan"]
        },
        "members": {
          "description": "bond で束ねる IF、ブリッジにつなぐ IF(同じ機器の IF 名。Proxmox VE の bond-slaves / bridge-ports)",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "examples": [["eno1", "eno2"]]
        },
        "bond-mode": {
          "description": "bond のモード",
          "type": "string",
          "enum": [
            "balance-rr",
            "active-backup",
            "balance-xor",
            "broadcast",
            "802.3ad",
            "balance-tlb",
            "balance-alb"
          ]
        },
        "vlan-aware": {
          "description": "ブリッジが VLAN aware(VLAN を区別して通す)か。省略すると false",
          "type": "boolean"
        },
        "vlan-raw-device": {
          "description": "VLAN インターフェースの親の IF。名前が「親.VLAN ID」(vmbr0.10)なら省略できる",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interfaceMode": {
      "description": "IF のモード: access(1 つの VLAN)/ trunk(複数の VLAN)/ routed(L3)",
      "type": "string",
      "enum": ["access", "trunk", "routed"]
    },
    "endpoint": {
      "description": "リンクの端「デバイスID:IF名」。最初の : でデバイスIDと IF 名に分ける。IF 名は長い名前・短い名前のどちらでも書ける",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*:\\s*\\S",
      "examples": ["rt1:Gi0/1", "core-sw1:GigabitEthernet0/1", "isp:wan"]
    },
    "link": {
      "description": "接続。a と b の順序に意味はない",
      "type": "object",
      "required": ["a", "b"],
      "additionalProperties": false,
      "properties": {
        "a": { "$ref": "#/definitions/endpoint" },
        "b": { "$ref": "#/definitions/endpoint" },
        "media": { "$ref": "#/definitions/media" },
        "label": {
          "description": "リンクの中央に表示する文字",
          "type": ["string", "number", "boolean"]
        }
      }
    },
    "media": {
      "description": "線の種類: copper(メタル)/ fiber(光)/ dac(ダイレクトアタッチケーブル)/ wireless(無線)/ virtual(仮想)。省略するとポートの種類から推定する",
      "type": "string",
      "enum": ["copper", "fiber", "dac", "wireless", "virtual"]
    },
    "point": {
      "description": "線の点の座標",
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "position": {
      "description": "機器の左上の座標",
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "viewport": {
      "description": "開いたときの表示位置と拡大率",
      "type": "object",
      "required": ["x", "y", "zoom"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number" }
      }
    },
    "labelOffset": {
      "description": "ラベルの位置。線の端から線に沿った距離(along)と、線からの横のずれ(side。線に沿って外を向いたときの右がプラス)",
      "type": "object",
      "required": ["along", "side"],
      "additionalProperties": false,
      "properties": {
        "along": { "type": "number" },
        "side": { "type": "number" }
      }
    },
    "group": {
      "description": "機器のまとまり",
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "グループの ID",
          "type": "string",
          "minLength": 1
        },
        "kind": { "$ref": "#/definitions/groupKind" },
        "label": {
          "description": "図に表示する名前",
          "type": ["string", "number", "boolean"]
        },
        "members": {
          "description": "含める機器のデバイスID",
          "type": "array",
          "items": { "$ref": "#/definitions/deviceId" }
        },
        "networks": {
          "description": "クラスタのネットワーク(kind: cluster のとき)。キー = ネットワークの名前(corosync・ceph-public・migration など)、値 = サブネット(10.10.0.0/24 の形。IPv4・IPv6)。サブネットに入る IP には、ラベルに名前を添える",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "sdnZone": {
      "description": "SDN のゾーン",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "ゾーンの種類: simple / vlan / qinq / vxlan / evpn",
          "type": "string",
          "enum": ["simple", "vlan", "qinq", "vxlan", "evpn"]
        },
        "bridge": {
          "description": "vlan・qinq で使う、各ホストのブリッジ(vmbr0 など。vlan・qinq では必須)",
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "description": "qinq の外側の VLAN ID(qinq では必須)",
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "nodes": {
          "description": "ゾーンを使うホストのデバイスID。省略時は、ロールが hypervisor の機器すべて",
          "type": "array",
          "items": { "$ref": "#/definitions/deviceId" }
        }
      }
    },
    "sdnVnet": {
      "description": "SDN の VNet",
      "type": "object",
      "required": ["zone"],
      "additionalProperties": false,
      "properties": {
        "zone": {
          "description": "ゾーンID",
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "description": "VLAN ID(vlan・qinq では 1〜4094。qinq では内側の VLAN)。vxlan・evpn では VNI。simple 以外では必須",
          "type": "integer",
          "minimum": 1,
          "maximum": 16777215
        },
        "subnets": {
          "description": "サブネット(10.40.0.0/24 の形)",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "groupKind": {
      "description": "グループの種類: site(拠点)/ rack(ラック)/ vlan / subnet / as / cluster(ハイパーバイザのクラスタ)/ custom",
      "type": "string",
      "enum": ["site", "rack", "vlan", "subnet", "as", "cluster", "custom"]
    }
  }
}
